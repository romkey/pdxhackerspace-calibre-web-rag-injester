# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- Calibre library (required) ---------------------------------------------

# Calibre's metadata.db, and the library folder that holds the book files.
# Compose mounts CALIBRE_LIBRARY_ROOT read-only at the same path.
CALIBRE_METADATA_DB=/data/calibre/metadata.db
CALIBRE_LIBRARY_ROOT=/data/calibre

# --- Links back to Calibre Web (optional) -----------------------------------

# Base URL of your Calibre Web, for source_url and opds_url in payloads.
# CALIBRE_WEB_BASE_URL=https://calibre-web.example.com
# Explicit download link template; {book_id} and {fmt} (or {format}) are filled in.
# CALIBRE_WEB_DOWNLOAD_URL_TEMPLATE=https://calibre-web.example.com/download/{book_id}/{fmt}

# --- Qdrant ------------------------------------------------------------------

# The compose files set QDRANT_URL to their own qdrant service.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=REPLACE_ME
QDRANT_COLLECTION=calibre_books
# cosine, dot or euclid; used only when creating the collection.
QDRANT_DISTANCE=cosine
# Must match the embedding model's dimension (text-embedding-3-small: 1536,
# or EMBEDDING_DIMENSIONS if set; nomic-embed-text: 768).
VECTOR_SIZE=1536

# --- Embeddings ----------------------------------------------------------------

# openai (default) or sentence_transformers (needs the sentence-transformers
# extra: pip install "calibre-web2rag[sentence-transformers]"). openai speaks
# the OpenAI embeddings API (POST {OPENAI_BASE_URL}/embeddings): api.openai.com
# or a compatible server such as Ollama (http://ollama:11434/v1), vLLM,
# LM Studio or LiteLLM.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
# Leave unset for self-hosted servers that don't need auth.
# OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_TIMEOUT_SECONDS=120
# Reduced-size vectors (text-embedding-3-* only); must match VECTOR_SIZE.
# EMBEDDING_DIMENSIONS=512
# Model context in tokens; longer texts (~4 chars/token) are truncated. 0 disables.
EMBEDDING_CONTEXT_LENGTH=8192

# Hugging Face model cache for sentence_transformers. The first one set wins.
# HF_CACHE_DIR=/hf-cache
# SENTENCE_TRANSFORMERS_HOME=/hf-cache
# HF_HOME=/hf-cache
# Host folder docker-compose.yaml mounts at HF_CACHE_DIR (not read by the app).
# HF_CACHE_HOST_DIR=./.cache/huggingface

# --- Chunking and batching -------------------------------------------------

CHUNK_SIZE=1200
CHUNK_OVERLAP=120
BATCH_SIZE=64

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Compose (not read by the app) -----------------------------------------

# Release of the image docker-compose.prod.yaml runs; default latest.
# APP_VERSION=0.3.0
# Model and its dimension for docker-compose.ollama.yaml; defaults
# nomic-embed-text and 768.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_VECTOR_SIZE=768

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
