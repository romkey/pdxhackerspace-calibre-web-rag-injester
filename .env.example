# Calibre library
CALIBRE_METADATA_DB=/data/calibre/metadata.db
CALIBRE_LIBRARY_ROOT=/data/calibre
CALIBRE_WEB_BASE_URL=https://calibre-web.example.com
# Optional explicit link template:
# CALIBRE_WEB_DOWNLOAD_URL_TEMPLATE=https://calibre-web.example.com/download/{book_id}/{fmt}

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=calibre_books
QDRANT_DISTANCE=cosine
# Must match the embedding model output size (768 for modernbert-embed-base).
VECTOR_SIZE=768

# Embeddings / chunking
# Default provider is openai, which speaks the OpenAI embeddings API
# (POST {OPENAI_BASE_URL}/embeddings). The default setup is a local,
# OpenAI-compatible server (e.g. Hugging Face text-embeddings-inference, vLLM,
# Infinity, LM Studio, LiteLLM, or Ollama at http://ollama:11434/v1) serving
# ModernBERT from Hugging Face. api.openai.com works too.
# sentence_transformers is available as an optional extra:
#   pip install calibre-web2rag[sentence-transformers]
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
OPENAI_BASE_URL=http://localhost:8080/v1
# Optional: leave empty for local servers that don't need auth.
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=120
# Optional: request reduced-size vectors (text-embedding-3-* only).
# Must match VECTOR_SIZE when set.
# EMBEDDING_DIMENSIONS=

# Embedding prompts (prefixes)
# Many embedding models are trained with a task prefix on each input: one for
# search queries, another for the documents being searched. Both default to
# empty (no prefix). The document prefix is used for everything the ingester
# stores; the query prefix is for text you search with.
#
# Known models (VECTOR_SIZE in brackets):
#   Model                                   Query prefix               Document prefix
#   nomic-ai/modernbert-embed-base [768]    "search_query: "           "search_document: "
#   nomic-embed-text (Ollama) [768]         "search_query: "           "search_document: "
#   e5 family (intfloat/e5-*, multilingual) "query: "                  "passage: "
#   mxbai-embed-large [1024]                "Represent this sentence   (none)
#                                            for searching relevant
#                                            passages: "
#   Qwen3-Embedding and similar             an instruction line, e.g.  (none)
#                                           "Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: "
#   OpenAI text-embedding-3-* [1536/3072]   (none)                     (none)
#
# Quote values in double quotes so the trailing space is kept; "\n" inside
# double quotes becomes a newline. The prefix counts toward
# EMBEDDING_CONTEXT_LENGTH when long texts are truncated.
#
# Changing EMBEDDING_DOCUMENT_PREFIX changes every stored vector: re-run the
# ingester to re-embed the whole library. Any other app that queries Qdrant
# directly must embed its queries with the same EMBEDDING_QUERY_PREFIX.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "

CHUNK_SIZE=1200
CHUNK_OVERLAP=120
BATCH_SIZE=64

# Max token context length for the embedding model. Texts exceeding this
# (estimated at ~4 chars/token) are truncated before embedding.
EMBEDDING_CONTEXT_LENGTH=8192
