# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- Calibre library (required) ---------------------------------------------

# Calibre's metadata.db, and the library folder that holds the book files.
# Compose mounts CALIBRE_LIBRARY_ROOT read-only at the same path.
CALIBRE_METADATA_DB=/data/calibre/metadata.db
CALIBRE_LIBRARY_ROOT=/data/calibre

# --- Links back to Calibre Web (optional) -----------------------------------

# Base URL of your Calibre Web, for source_url and opds_url in payloads.
# CALIBRE_WEB_BASE_URL=https://calibre-web.example.com
# Explicit download link template; {book_id} and {fmt} (or {format}) are filled in.
# CALIBRE_WEB_DOWNLOAD_URL_TEMPLATE=https://calibre-web.example.com/download/{book_id}/{fmt}
# Book page link template; {book_id} is filled in. Default <base>/book/{book_id}.
# CALIBRE_WEB_BOOK_URL_TEMPLATE=https://calibre-web.example.com/book/{book_id}

# --- PostgreSQL: staging store, entity registry, catalog table ---------------

# The compose files set DATABASE_URL to their own db service in development
# and tests. In production, set it here to match the POSTGRES_* values below.
DATABASE_URL=postgresql://app:REPLACE_ME@db:5432/app
# Used by docker-compose.prod.yaml's db service (not read by the app).
POSTGRES_USER=app
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=app

# --- Qdrant ------------------------------------------------------------------

# The compose files set QDRANT_URL to their own qdrant service.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=REPLACE_ME
# Member-tier collections. This ingester never writes to hs_public.
# QDRANT_MEMBER_COLLECTION=hs_member
# QDRANT_CATALOG_COLLECTION=hs_catalog
# QDRANT_BOOKTEXT_COLLECTION=hs_booktext
# cosine, dot or euclid; used only when creating the collection.
QDRANT_DISTANCE=cosine
# Must match the embedding model's dimension (modernbert-embed-base and
# nomic-embed-text: 768; text-embedding-3-small: 1536, or EMBEDDING_DIMENSIONS).
VECTOR_SIZE=768

# --- Embeddings ----------------------------------------------------------------

# openai (default) or sentence_transformers (needs the sentence-transformers
# extra: pip install "calibre-web2rag[sentence-transformers]"). openai speaks
# the OpenAI embeddings API (POST {OPENAI_BASE_URL}/embeddings). The default
# is a local OpenAI-compatible server (Hugging Face text-embeddings-inference,
# vLLM, Infinity, LM Studio, LiteLLM, or Ollama at http://ollama:11434/v1)
# serving ModernBERT; api.openai.com works too. Inside a container, localhost
# is the container: use e.g. http://host.docker.internal:8080/v1 instead.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=nomic-ai/modernbert-embed-base
OPENAI_BASE_URL=http://localhost:8080/v1
# Leave unset for local servers that don't need auth.
# OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_TIMEOUT_SECONDS=120
# Reduced-size vectors (text-embedding-3-* only); must match VECTOR_SIZE.
# EMBEDDING_DIMENSIONS=512
# Model context in tokens; longer texts (~4 chars/token) are truncated. 0 disables.
EMBEDDING_CONTEXT_LENGTH=8192

# Task prefixes many embedding models expect: one on search queries, one on
# the documents searched. Both default to empty. The ingester stores
# everything with the document prefix; apps that search the collection must
# embed queries with the query prefix. These are for ModernBERT and
# nomic-embed-text; see docs/configuration.md for other models. Use double
# quotes so the trailing space is kept. Changing the document prefix changes
# every vector: re-run the ingester to re-embed the library.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "

# Hugging Face model cache for sentence_transformers. The first one set wins.
# HF_CACHE_DIR=/hf-cache
# SENTENCE_TRANSFORMERS_HOME=/hf-cache
# HF_HOME=/hf-cache
# Host folder docker-compose.yaml mounts at HF_CACHE_DIR (not read by the app).
# HF_CACHE_HOST_DIR=./.cache/huggingface

# --- Generation (ingest-time LLM tasks) ---------------------------------------

# Chat model for topics, "good for" summaries, chunk context and linker
# checks, through the OpenAI-compatible gateway. Unset: those steps are
# skipped. Base URL and key default to OPENAI_BASE_URL and OPENAI_API_KEY.
# LLM_MODEL=qwen3-30b-a3b
# LLM_BASE_URL=http://gateway:4000/v1
# LLM_API_KEY=REPLACE_ME
# LLM_TIMEOUT_SECONDS=120
# Topic taxonomy file (one slug per line); default: the copy in the package.
# TOPIC_TAXONOMY_FILE=/config/taxonomy.txt

# --- Enrichment (Open Library, then Google Books) -----------------------------

# Looks up descriptions and subjects for books that lack them.
# ENRICHMENT_ENABLED=true
# ENRICHMENT_TIMEOUT_SECONDS=20
# Optional; Google Books allows a few requests a day without one.
# GOOGLE_BOOKS_API_KEY=REPLACE_ME

# --- Library overview and full text -------------------------------------------

# How members request additions, for the library overview document.
# LIBRARY_REQUEST_INFO=Ask in #library on Slack to suggest a book.
# Index the full text of DRM-free books into hs_booktext (off by default).
# BOOKTEXT_ENABLED=false

# --- Chunking and batching -------------------------------------------------

# About 450 tokens; the hard cap is the embedding context length.
CHUNK_SIZE=1800
CHUNK_OVERLAP=150
BATCH_SIZE=64

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO

# --- Scheduling (the default `serve` command) ------------------------------
# Minutes to sleep between scans, >= 1.
SCAN_INTERVAL_MINUTES=60
# A scan is a full one (which also removes deleted books) when no full scan
# has finished in this many hours, >= 1; otherwise it is incremental.
FULL_SCAN_INTERVAL_HOURS=24

# --- Compose (not read by the app) -----------------------------------------

# Release of the image docker-compose.prod.yaml runs; default latest.
# APP_VERSION=0.3.0
# Model and its dimension for docker-compose.ollama.yaml; defaults
# nomic-embed-text and 768.
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_VECTOR_SIZE=768

# --- Publishing to PyPI (optional; not read by the app) --------------------
# Only for publishing by hand from your machine (`uv publish`); releases
# from GitHub use trusted publishing or the PYPI_API_TOKEN repository
# secret instead; see
# https://github.com/romkey/python-ai-rules/blob/main/docs/releasing.md
# A project-scoped API token from https://pypi.org/manage/account/token/. Keep it out of
# .env on servers: compose passes .env to the app.
# UV_PUBLISH_TOKEN=pypi-REPLACE_ME
